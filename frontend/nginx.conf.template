server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # API calls go to the Spring Boot backend
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Bulk replays and error breakdowns can take a while on big DLQs
        proxy_read_timeout 120s;
    }

    # Vite puts a content hash in asset file names, so they can be cached forever
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # React Router: unknown paths (e.g. /dlq-topics/123) load the app, which handles the route
    location / {
        try_files $uri $uri/ /index.html;
    }
}
